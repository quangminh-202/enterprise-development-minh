@inject PolyclinicApiWrapper PolyclinicApi
@inject IJSRuntime JSRuntime
@using Polyclinic.Client.Wasm

<Card>
    <CardHeader>
        <Row Class="justify-content-between align-items-center">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h5 class="mb-0">
                    <Icon Name="IconName.Home" Class="text-info me-2" />
                    Appointments by Room
                </h5>
            </Column>
            <Column ColumnSize="ColumnSize.IsAuto">
                <Row Class="g-2 align-items-center">
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <NumericEdit @bind-Value="RoomNumber" 
                                   Min="100" 
                                   Max="999" 
                                   Size="Size.Small" 
                                   Style="width: 80px;" />
                    </Column>
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <Button Color="Color.Primary" 
                                Size="Size.Small" 
                                Clicked="LoadData"
                                Loading="IsLoading">
                            <Icon Name="IconName.Search" /> Load
                        </Button>
                    </Column>
                </Row>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        @if (IsLoading)
        {
            <div class="text-center p-3">
                <p class="mt-2 text-muted">Loading room appointments...</p>
            </div>
        }
        else if (RoomAppointments != null && RoomAppointments.Any())
        {
            <DataGrid TItem="AppointmentDto"
                      Data="RoomAppointments"
                      Responsive
                      ShowPager="false"
                      Striped>
                <DataGridColumns>
                    <DataGridColumn TItem="AppointmentDto"
                                    Field="@nameof(AppointmentDto.Date)"
                                    Caption="Date & Time">
                        <DisplayTemplate>
                            <div>
                                <strong>@context.Date.ToString("dd/MM/yyyy")</strong>
                                <br />
                                <small class="text-muted">@context.Date.ToString("HH:mm")</small>
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                    
                    <DataGridColumn TItem="AppointmentDto"
                                    Field="@nameof(AppointmentDto.DoctorName)"
                                    Caption="Doctor">
                        <DisplayTemplate>
                            <div class="d-flex align-items-center">
                                <Icon Name="IconName.User" Class="text-success me-2" />
                                <span>@context.DoctorName</span>
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                    
                    <DataGridColumn TItem="AppointmentDto"
                                    Field="@nameof(AppointmentDto.PatientName)"
                                    Caption="Patient">
                        <DisplayTemplate>
                            <div class="d-flex align-items-center">
                                <Icon Name="IconName.User" Class="text-primary me-2" />
                                <span>@context.PatientName</span>
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                    
                    <DataGridColumn TItem="AppointmentDto"
                                    Field="@nameof(AppointmentDto.IsRepeated)"
                                    Caption="Type">
                        <DisplayTemplate>
                            @if (context.IsRepeated)
                            {
                                <Badge Color="Color.Success">
                                    Repeated
                                </Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Secondary">
                                    <Icon Name="IconName.PlusCircle" /> New
                                </Badge>
                            }
                        </DisplayTemplate>
                    </DataGridColumn>
                </DataGridColumns>
            </DataGrid>
        }
        else
        {
            <Alert Color="Color.Info" Visible>
                <Icon Name="IconName.InfoCircle" Class="me-2" />
                No appointments found in room @RoomNumber.
            </Alert>
        }
    </CardBody>
</Card>

@code {
    [Parameter] public int RoomNumber { get; set; } = 101;
    [Parameter] public EventCallback<int> RoomNumberChanged { get; set; }

    private IList<AppointmentDto> RoomAppointments { get; set; } = new List<AppointmentDto>();
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            var appointments = await PolyclinicApi.GetAppointmentsInRoom(RoomNumber);
            RoomAppointments = appointments.OrderBy(a => a.Date).ToList();
        }
        catch (ApiException apiEx) when (apiEx.StatusCode == 404)
        {
            RoomAppointments = new List<AppointmentDto>();
        }
        catch
        {
            RoomAppointments = new List<AppointmentDto>();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
@inject PolyclinicApiWrapper PolyclinicApi
@inject IJSRuntime JSRuntime

<Card>
    <CardHeader>
        <Row Class="justify-content-between align-items-center">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h5 class="mb-0">
                    <Icon Name="IconName.Star" Class="text-warning me-2" />
                    Experienced Doctors
                </h5>
            </Column>
            <Column ColumnSize="ColumnSize.IsAuto">
                <Row Class="g-2 align-items-center">
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <NumericEdit @bind-Value="MinExperience" 
                                   Min="0" 
                                   Max="50" 
                                   Size="Size.Small" 
                                   Style="width: 80px;" />
                    </Column>
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <Button Color="Color.Primary" 
                                Size="Size.Small" 
                                Clicked="LoadData"
                                Loading="IsLoading">
                            <Icon Name="IconName.Search" /> Load
                        </Button>
                    </Column>
                </Row>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        @if (IsLoading)
        {
            <div class="text-center p-3">
                <p class="mt-2 text-muted">Loading experienced doctors...</p>
            </div>
        }
        else if (ExperiencedDoctors != null && ExperiencedDoctors.Any())
        {
            <DataGrid TItem="DoctorDto"
                      Data="ExperiencedDoctors"
                      Responsive
                      ShowPager="false"
                      Striped>
                <DataGridColumns>
                    <DataGridColumn TItem="DoctorDto"
                                    Field="@nameof(DoctorDto.FullName)"
                                    Caption="Doctor">
                        <DisplayTemplate>
                            <div class="d-flex align-items-center">
                                <Icon Name="IconName.User" Class="text-success me-2" />
                                <strong>@context.FullName</strong>
                            </div>
                        </DisplayTemplate>
                    </DataGridColumn>
                    
                    <DataGridColumn TItem="DoctorDto"
                                    Field="@nameof(DoctorDto.Specialization)"
                                    Caption="Specialization">
                        <DisplayTemplate>
                            <Badge Color="Color.Info">@context.Specialization</Badge>
                        </DisplayTemplate>
                    </DataGridColumn>
                    
                    <DataGridColumn TItem="DoctorDto"
                                    Field="@nameof(DoctorDto.Experience)"
                                    Caption="Experience">
                        <DisplayTemplate>
                            <Badge Color="Color.Warning">
                                <Icon Name="IconName.Star" /> @context.Experience years
                            </Badge>
                        </DisplayTemplate>
                    </DataGridColumn>
                </DataGridColumns>
            </DataGrid>
        }
        else
        {
            <Alert Color="Color.Info" Visible>
                <Icon Name="IconName.InfoCircle" Class="me-2" />
                No experienced doctors found with @MinExperience+ years of experience.
            </Alert>
        }
    </CardBody>
</Card>

@code {
    [Parameter] public int MinExperience { get; set; } = 10;
    [Parameter] public EventCallback<int> MinExperienceChanged { get; set; }

    private IList<DoctorDto> ExperiencedDoctors { get; set; } = new List<DoctorDto>();
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            var doctors = await PolyclinicApi.GetExperiencedDoctors(MinExperience);
            ExperiencedDoctors = doctors.OrderByDescending(d => d.Experience).ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading experienced doctors: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
@inject PolyclinicApiWrapper PolyclinicApi
@inject IJSRuntime JSRuntime

<Card>
    <CardHeader>
        <Row Class="justify-content-between align-items-center">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h5 class="mb-0">
                    Repeated Appointments
                </h5>
            </Column>
            <Column ColumnSize="ColumnSize.IsAuto">
                <Row Class="g-2 align-items-center">
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <NumericEdit @bind-Value="Months" 
                                   Min="1" 
                                   Max="12" 
                                   Size="Size.Small" 
                                   Style="width: 80px;" />
                    </Column>
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <small class="text-muted">months</small>
                    </Column>
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <Button Color="Color.Primary" 
                                Size="Size.Small" 
                                Clicked="LoadData"
                                Loading="IsLoading">
                            <Icon Name="IconName.Search" /> Load
                        </Button>
                    </Column>
                </Row>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        @if (IsLoading)
        {
            <div class="text-center p-3">
                <p class="mt-2 text-muted">Loading repeated appointments...</p>
            </div>
        }
        else if (RepeatedAppointments != null)
        {
            <Row Class="mb-3">
                <Column ColumnSize="ColumnSize.Is12">
                    <Alert Color="Color.Success" Visible>
                        <Icon Name="IconName.InfoCircle" Class="me-2" />
                        <strong>@RepeatedAppointments.TotalCount</strong> repeated appointments found in the last @Months month(s).
                    </Alert>
                </Column>
            </Row>

            @if (RepeatedAppointments.Appointments != null && RepeatedAppointments.Appointments.Any())
            {
                <DataGrid TItem="AppointmentDto"
                          Data="RepeatedAppointments.Appointments"
                          Responsive
                          ShowPager="false"
                          Striped>
                    <DataGridColumns>
                        <DataGridColumn TItem="AppointmentDto"
                                        Field="@nameof(AppointmentDto.Date)"
                                        Caption="Date">
                            <DisplayTemplate>
                                <div>
                                    <strong>@context.Date.ToString("dd/MM/yyyy")</strong>
                                    <br />
                                    <small class="text-muted">@context.Date.ToString("HH:mm")</small>
                                </div>
                            </DisplayTemplate>
                        </DataGridColumn>
                        
                        <DataGridColumn TItem="AppointmentDto"
                                        Field="@nameof(AppointmentDto.PatientName)"
                                        Caption="Patient">
                            <DisplayTemplate>
                                <Icon Name="IconName.User" Class="text-primary me-2" />
                                @context.PatientName
                            </DisplayTemplate>
                        </DataGridColumn>
                        
                        <DataGridColumn TItem="AppointmentDto"
                                        Field="@nameof(AppointmentDto.DoctorName)"
                                        Caption="Doctor">
                            <DisplayTemplate>
                                <Icon Name="IconName.User" Class="text-success me-2" />
                                @context.DoctorName
                            </DisplayTemplate>
                        </DataGridColumn>
                        
                        <DataGridColumn TItem="AppointmentDto"
                                        Field="@nameof(AppointmentDto.Room)"
                                        Caption="Room">
                            <DisplayTemplate>
                                <Badge Color="Color.Info">
                                    <Icon Name="IconName.Home" /> @context.Room
                                </Badge>
                            </DisplayTemplate>
                        </DataGridColumn>
                    </DataGridColumns>
                </DataGrid>
            }
        }
        else
        {
            <Alert Color="Color.Info" Visible>
                <Icon Name="IconName.InfoCircle" Class="me-2" />
                No repeated appointments found in the last @Months month(s).
            </Alert>
        }
    </CardBody>
</Card>

@code {
    [Parameter] public int Months { get; set; } = 1;
    [Parameter] public EventCallback<int> MonthsChanged { get; set; }

    private RepeatedAppointmentsAnalyticsDto? RepeatedAppointments { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            RepeatedAppointments = await PolyclinicApi.GetRepeatedAppointments(Months);
        }
        catch
        {
            RepeatedAppointments = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
@page "/"
@inject PolyclinicApiWrapper PolyclinicApi
@inject NavigationManager Navigation

<PageTitle>Polyclinic Management System</PageTitle>

<Container Fluid>
    <!-- Hero Section -->
    <Card Class="mb-4 bg-gradient-primary text-white">
        <CardBody Class="text-center py-5">
            <Icon Name="IconName.Hospital" Style="font-size: 4rem; margin-bottom: 1rem;" />
            <h1 class="display-4 mb-3">Polyclinic Management System</h1>
            <p class="lead">Comprehensive and modern healthcare management solution</p>
        </CardBody>
    </Card>

    <!-- Quick Actions -->
    <Row Class="g-4 mb-5">
        <Column ColumnSize="ColumnSize.Is3">
            <Card Class="h-100 text-center shadow-sm hover-card">
                <CardBody>
                    <Icon Name="IconName.Users" Style="font-size: 3rem; color: #007bff;" />
                    <h5 class="mt-3">Patients</h5>
                    <p class="text-muted">Manage patient records, medical history, and personal information.</p>
                    <Button Color="Color.Primary" Clicked="() => NavigateToPatients()">
                        Manage Patients
                    </Button>
                </CardBody>
            </Card>
        </Column>
        
        <Column ColumnSize="ColumnSize.Is3">
            <Card Class="h-100 text-center shadow-sm hover-card">
                <CardBody>
                    <Icon Name="IconName.User" Style="font-size: 3rem; color: #28a745;" />
                    <h5 class="mt-3">Doctors</h5>
                    <p class="text-muted">Manage doctor profiles, specializations, and work experience.</p>
                    <Button Color="Color.Success" Clicked="() => NavigateToDoctors()">
                        Manage Doctors
                    </Button>
                </CardBody>
            </Card>
        </Column>
        
        <Column ColumnSize="ColumnSize.Is3">
            <Card Class="h-100 text-center shadow-sm hover-card">
                <CardBody>
                    <Icon Name="IconName.Calendar" Style="font-size: 3rem; color: #ffc107;" />
                    <h5 class="mt-3">Appointments</h5>
                    <p class="text-muted">Schedule and manage appointments between patients and doctors.</p>
                    <Button Color="Color.Warning" Clicked="() => NavigateToAppointments()">
                        Manage Appointments
                    </Button>
                </CardBody>
            </Card>
        </Column>
        
        <Column ColumnSize="ColumnSize.Is3">
            <Card Class="h-100 text-center shadow-sm hover-card">
                <CardBody>
                    <Icon Name="IconName.ChartLine" Style="font-size: 3rem; color: #17a2b8;" />
                    <h5 class="mt-3">Analytics</h5>
                    <p class="text-muted">View reports and analytics for better decision making.</p>
                    <Button Color="Color.Info" Clicked="() => NavigateToAnalytics()">
                        View Analytics
                    </Button>
                </CardBody>
            </Card>
        </Column>
    </Row>

    <!-- Dashboard Content -->
    <Row>
        <Column ColumnSize="ColumnSize.Is8">
            <Card Class="shadow-sm">
                <CardHeader>
                    <h5 class="mb-0">
                        <Icon Name="IconName.Star" /> System Features
                    </h5>
                </CardHeader>
                <CardBody>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is6">
                            <ListGroup Flush>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Patient Management
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Doctor Management
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Appointment Scheduling
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Medical Records
                                </ListGroupItem>
                            </ListGroup>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is6">
                            <ListGroup Flush>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Real-time Updates (NATS)
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    MongoDB Integration
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Analytics & Reports
                                </ListGroupItem>
                                <ListGroupItem>
                                    <Icon Name="IconName.Check" Class="text-success me-2" />
                                    Responsive Design
                                </ListGroupItem>
                            </ListGroup>
                        </Column>
                    </Row>
                </CardBody>
            </Card>
        </Column>
        
        <Column ColumnSize="ColumnSize.Is4">
            <Card Class="shadow-sm">
                <CardHeader>
                    <h5 class="mb-0">
                        <Icon Name="IconName.Dashboard" /> Quick Stats
                    </h5>
                </CardHeader>
                <CardBody>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>
                            <Icon Name="IconName.Users" Class="me-2" />
                            Total Patients:
                        </span>
                        <Badge Color="Color.Primary">@TotalPatients</Badge>
                    </div>
                    <Divider />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>
                            <Icon Name="IconName.User" Class="me-2" />
                            Total Doctors:
                        </span>
                        <Badge Color="Color.Success">@TotalDoctors</Badge>
                    </div>
                    <Divider />
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            <Icon Name="IconName.Calendar" Class="me-2" />
                            Today's Appointments:
                        </span>
                        <Badge Color="Color.Warning">@TodayAppointments</Badge>
                    </div>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    }
    
    .hover-card {
        transition: transform 0.2s ease-in-out;
    }
    
    .hover-card:hover {
        transform: translateY(-5px);
    }
    
    .stretched-link::after {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1;
        content: "";
    }
</style>

@code {
    private int TotalPatients { get; set; } = 0;
    private int TotalDoctors { get; set; } = 0;
    private int TodayAppointments { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuickStats();
    }

    private async Task LoadQuickStats()
    {
        try
        {
            var patients = await PolyclinicApi.GetAllPatients();
            TotalPatients = patients?.Count() ?? 0;

            var doctors = await PolyclinicApi.GetAllDoctors();
            TotalDoctors = doctors?.Count() ?? 0;

            var appointments = await PolyclinicApi.GetAllAppointments();
            TodayAppointments = appointments?.Count(a => a.Date.Date == DateTime.Today) ?? 0;
        }
        catch (Exception)
        {
            TotalPatients = 0;
            TotalDoctors = 0;
            TodayAppointments = 0;
        }
    }

    private void NavigateToPatients() => Navigation.NavigateTo("/patients");

    private void NavigateToDoctors() => Navigation.NavigateTo("/doctors");

    private void NavigateToAppointments() => Navigation.NavigateTo("/appointments");

    private void NavigateToAnalytics() => Navigation.NavigateTo("/analytics");
}